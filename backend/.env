# ═══════════════════════════════════════════════════════
#  ProTask · Backend Environment Variables
#  File: backend/.env
#
#  This file is used for LOCAL development only.
#  In Docker, these values are supplied by docker-compose.yml
#  DO NOT commit this file to Git (add to .gitignore)
# ═══════════════════════════════════════════════════════

PORT=5000

# Local MongoDB (must be running: mongod or Docker mongo container)
MONGO_URI=mongodb://localhost:27018/appdb

# For local dev, frontend runs at 5500 — allow both
CORS_ORIGIN=http://127.0.0.1:5500